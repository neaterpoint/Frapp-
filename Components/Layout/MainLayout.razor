@inherits LayoutComponentBase

<div class="relative flex flex-col sm:flex-row">
    <div class="bg-linear-to-b from-[rgb(5,39,103)] to-[#3a0647] to-70% sm:sticky sm:top-0 sm:h-screen sm:w-[250px]">
        <NavMenu />
    </div>

    <main class="flex-1">
        <div class="flex h-14 items-center justify-between border-b border-[#d6d5d5] bg-[#f7f7f7] px-4
                    sm:sticky sm:top-0 sm:z-10 sm:justify-end sm:pr-6 sm:pl-8">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank"
               class="truncate whitespace-nowrap no-underline hover:underline sm:ml-6">About</a>
        </div>

        <article class="px-4 pt-[1.1rem] sm:pr-6 sm:pl-8">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet
     class="fixed bottom-0 left-0 z-[1000] hidden w-full bg-[lightyellow] px-5 pt-[0.6rem] pb-[0.7rem] shadow-[0_-1px_2px_rgba(0,0,0,0.2)] [color-scheme:light]">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss absolute top-2 right-3 cursor-pointer">🗙</span>
</div>