@inherits LayoutComponentBase

<div class="relative flex flex-col min-h-screen">
    <main class="flex flex-col flex-1">
        
        <!-- NAVBAR CONTAINER: Clean structural utilities + our custom .main-navbar class -->
        <div class="flex h-17 items-center justify-between px-4 sm:sticky sm:top-0 sm:z-10 sm:px-6 main-navbar">
            
            <AuthorizeView>
                <Authorized>
                    <!-- Left Side: Logged-in Home Logo -->
                    @* TODO: change to logo *@
                    <a href="/home" class="flex items-center gap-2 font-bold no-underline hover:opacity-90">
                        <span>MyLogo (In)</span>
                    </a>

                    <!-- Right Side: Profile Link -->
                    <a href="/profile" class="flex items-center gap-2 text-sm font-medium no-underline hover:opacity-75">
                        <span>Profile</span>
                    </a>
                </Authorized>

                <NotAuthorized>
                    <!-- Left Side: Logged-out Public Home Logo (Frappé text layout) -->
                    <a href="/" class="flex items-center gap-2 font-black tracking-widest text-xl uppercase no-underline">
                        <span>Frappé</span>
                    </a>

                    <!-- Right Side: Clean Nav Button links using your new CSS class -->
                    <div class="flex items-center gap-3">
                        <a href="/login" class="nav-btn">
                            Login
                        </a>
                        <a href="/register" class="nav-btn">
                            Register
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

        </div>

        <!-- MAIN APP BODY: Stripped of background utilities so it uses .main-content-body -->
        <article class="flex-1 px-4 pt-[1.1rem] sm:pr-6 sm:pl-8 main-content-body">
            @Body
        </article>

    </main>
</div>
