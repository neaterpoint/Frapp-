@page "/"

<PageTitle>Frappé - Savor the Moment</PageTitle>

<div class="landing-hero">
    
    <!-- Hero Heading (All caps, tracking-wider matches Canva image) -->
    <h1 class="text-3xl sm:text-4xl font-black tracking-widest text-brand-brown mb-2 uppercase">
        A Latte Memories in Every Sip.
    </h1>
    
    <!-- Hero Subtitle Text -->
    <p class="text-xs sm:text-sm font-medium tracking-wider text-brand-brown/70 max-w-lg mb-8 uppercase">
        Track your flavor journey over time and stay connected through your daily brews.
    </p>

    <!-- Center Stack Action Links -->
    <div class="flex flex-col gap-4">
        <a href="/login" class="hero-btn">
            Login
        </a>
        <a href="/register" class="hero-btn">
            Register
        </a>
    </div>

</div>
