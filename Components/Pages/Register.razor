@page "/register"

<PageTitle>Frappé - Register</PageTitle>

<div class="feed-container">
    
    <!-- Title Wrapper -->
    <div class="w-full max-w-xl mb-4 px-2">
        <h2 class="text-3xl font-black tracking-widest uppercase text-brand-brown">
            Register
        </h2>
    </div>

    <!-- Card Box Container -->
    <div class="w-full max-w-xl bg-default-container-background border border-brand-brown/30 rounded-2xl p-8 shadow-sm">
        
        <!-- Username Field -->
        <div class="mb-4">
            <label class="block text-xs font-bold tracking-wider uppercase text-brand-brown/70 mb-2">
                Username
            </label>
            <input type="text" placeholder="coffee_lover" 
                   class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-default-home-background text-brand-brown focus:outline-none focus:border-brand-brown/60 transition-colors" />
        </div>

        <!-- Email Field -->
        <div class="mb-4">
            <label class="block text-xs font-bold tracking-wider uppercase text-brand-brown/70 mb-2">
                Email Address
            </label>
            <input type="email" placeholder="you@example.com" 
                   class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-default-home-background text-brand-brown focus:outline-none focus:border-brand-brown/60 transition-colors" />
        </div>

        <!-- Birthdate Field (Date Picker) -->
        <div class="mb-4">
            <label class="block text-xs font-bold tracking-wider uppercase text-brand-brown/70 mb-2">
                Birthdate
            </label>
            <input type="date" 
                   class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-default-home-background text-brand-brown focus:outline-none focus:border-brand-brown/60 transition-colors" />
        </div>

        <!-- Password Field -->
        <div class="mb-4">
            <label class="block text-xs font-bold tracking-wider uppercase text-brand-brown/70 mb-2">
                Password
            </label>
            <input type="password" placeholder="••••••••" 
                   class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-default-home-background text-brand-brown focus:outline-none focus:border-brand-brown/60 transition-colors" />
        </div>

        <!-- Confirm Password Field -->
        <div class="mb-8">
            <label class="block text-xs font-bold tracking-wider uppercase text-brand-brown/70 mb-2">
                Confirm Password
            </label>
            <input type="password" placeholder="••••••••" 
                   class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-default-home-background text-brand-brown focus:outline-none focus:border-brand-brown/60 transition-colors" />
        </div>

        <!-- Action Button Stack -->
        <div class="flex flex-col items-center gap-3">
            
            <!-- Link that transitions straight to your homepage feed mockup -->
            <a href="/home" class="hero-btn w-full text-center">
                Create Account
            </a>
            
            <a href="/" class="text-xs font-medium tracking-wider uppercase text-brand-brown/60 no-underline hover:text-brand-brown transition-colors mt-2">
                ← Back to Home
            </a>
            
        </div>

    </div>

</div>
